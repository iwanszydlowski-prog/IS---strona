<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iwan Szydłowski — Pianista</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="image" href="images/hero.jpg" fetchpriority="high">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      /* Palette: Quiet Luxury / Deep Velvet Emerald & Ice */
      --color-bg: #060907;
      --color-surface: #0B120E;
      --color-surface-translucent: rgba(6, 9, 7, 0.85);
      --color-border: rgba(230, 228, 221, 0.08);
      
      --color-text-primary: #F2EFEB;
      --color-text-muted: rgba(242, 239, 235, 0.5);
      --color-accent-ice: #C2D6CE;

      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
      
      --nav-height: 72px;
      --container-max: 1600px;
      --transition-smooth: 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
      background-color: var(--color-bg);
    }

    body {
      background-color: var(--color-bg);
      color: var(--color-text-primary);
      font-family: var(--font-sans);
      min-height: 100vh;
      min-height: 100dvh;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      line-height: 1.6;
      overflow-x: hidden;
    }

    :focus-visible {
      outline: 1px solid var(--color-accent-ice);
      outline-offset: 4px;
    }

    /* --- Site Header --- */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--nav-height);
      z-index: 100;
      background-color: transparent;
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      border-bottom: 1px solid transparent;
      transition: background-color var(--transition-smooth), 
                  backdrop-filter var(--transition-smooth),
                  border-color var(--transition-smooth);
      transform: translateZ(0);
    }

    .site-header.scrolled {
      background-color: var(--color-surface-translucent);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-container {
      max-width: var(--container-max);
      height: 100%;
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 4vw, 4rem);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-name {
      font-size: 0.75rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--color-text-primary);
      text-decoration: none;
      transition: opacity var(--transition-smooth);
      white-space: nowrap;
    }

    .brand-name:hover {
      opacity: 0.7;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: clamp(1.25rem, 2.5vw, 2.5rem);
      list-style: none;
    }

    .nav-link {
      font-size: 0.6875rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--color-text-muted);
      text-decoration: none;
      transition: color var(--transition-smooth);
    }

    .nav-link:hover,
    .nav-link[aria-current="page"] {
      color: var(--color-text-primary);
    }

    /* --- Hero Stage --- */
    .hero-fixed {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      z-index: 1;
      display: flex;
      align-items: flex-end;
    }

    .hero-bg-layer {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .hero-bg-layer::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(6, 9, 7, 0.4) 0%,
        rgba(6, 9, 7, 0.2) 50%,
        rgba(6, 9, 7, 0.85) 100%
      );
    }

    .hero-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
      display: block;
    }

    .hero-text-container {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 clamp(1.5rem, 4vw, 4rem) clamp(4rem, 8vh, 6rem);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .hero-main-copy {
      max-width: 960px;
    }

    .hero-tag {
      display: block;
      font-size: 0.6875rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: var(--color-accent-ice);
      margin-bottom: 1.25rem;
      opacity: 0.9;
    }

    .hero-title {
      font-family: var(--font-serif);
      font-size: clamp(2rem, 3.8vw, 3.75rem);
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--color-text-primary);
      max-width: 960px;
      text-wrap: balance;
    }

    .hero-title em {
      display: inline;
      font-style: italic;
      font-weight: 300;
      font-family: var(--font-serif);
      color: var(--color-text-primary);
    }

    .scroll-indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding-bottom: 0.5rem;
    }

    .scroll-line-track {
      width: 1px;
      height: 40px;
      background-color: rgba(230, 228, 221, 0.15);
      position: relative;
      overflow: hidden;
    }

    .scroll-line-bar {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: var(--color-accent-ice);
      transform-origin: top;
      animation: scrollDown 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    @keyframes scrollDown {
      0% { transform: scaleY(0); transform-origin: top; }
      45% { transform: scaleY(1); transform-origin: top; }
      55% { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }

    .hero-spacer {
      height: 100vh;
      height: 100dvh;
      position: relative;
      z-index: 2;
      pointer-events: none;
    }

    /* --- Content Curtain --- */
    .content-curtain {
      position: relative;
      z-index: 3;
      background-color: var(--color-bg);
      min-height: 100vh;
      min-height: 100dvh;
      box-shadow: 0 -25px 50px rgba(0, 0, 0, 0.7);
    }

    /* --- Performance Scaffolding --- */
    .section-showcase,
    .section-about,
    .section-engagements,
    .section-repertoire,
    .section-contact {
      content-visibility: auto;
      contain-intrinsic-size: 800px;
    }

    /* --- Section: Showcase (Audio) --- */
    .section-showcase {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: clamp(5rem, 10vh, 9rem) clamp(1.5rem, 4vw, 4rem);
    }

    .showcase-stage {
      position: relative;
      width: 100%;
      max-width: 1100px;
      margin: 0 auto;
    }

    .showcase-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2rem;
      gap: 1.5rem;
    }

    .showcase-tag {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: var(--color-text-muted);
      flex-shrink: 0;
    }

    .showcase-caption {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--color-text-muted);
      text-align: right;
    }

    .video-frame-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
      overflow: hidden;
    }

    .video-frame-wrapper iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    .video-facade {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: var(--color-surface);
      border: none;
      padding: 0;
      cursor: pointer;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.4s ease;
    }

    .video-facade.is-hidden {
      opacity: 0;
      pointer-events: none;
    }

    .video-poster-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .video-poster-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(6, 9, 7, 0.2) 30%, rgba(6, 9, 7, 0.75) 100%);
      transition: background 0.4s ease;
    }

    .video-facade:hover .video-poster-img,
    .video-facade:focus-visible .video-poster-img {
      transform: scale(1.02);
    }

    .play-btn-circle {
      position: relative;
      z-index: 3;
      width: 68px;
      height: 68px;
      border-radius: 50%;
      border: 1px solid rgba(230, 228, 221, 0.3);
      background: rgba(11, 18, 14, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: border-color var(--transition-smooth), transform var(--transition-smooth), box-shadow var(--transition-smooth);
    }

    .play-btn-circle svg {
      width: 15px;
      height: 15px;
      fill: var(--color-text-primary);
      margin-left: 3px;
      transition: fill var(--transition-smooth);
    }

    .video-facade:hover .play-btn-circle,
    .video-facade:focus-visible .play-btn-circle {
      border-color: var(--color-accent-ice);
      transform: scale(1.06);
      box-shadow: 0 0 35px -5px rgba(194, 214, 206, 0.25);
    }

    .video-facade:hover .play-btn-circle svg,
    .video-facade:focus-visible .play-btn-circle svg {
      fill: var(--color-accent-ice);
    }

    /* --- Section: About --- */
    .section-about {
      max-width: var(--container-max);
      margin: 0 auto;
      padding-block: clamp(6rem, 12vh, 10rem);
      padding-inline: clamp(1.5rem, 4vw, 4rem);
      border-top: 1px solid var(--color-border);
    }

    .about-grid {
      display: grid;
      grid-template-columns: minmax(280px, 380px) 1fr;
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }

    .about-visual-col {
      position: relative;
      width: 100%;
    }

    .about-portrait-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      overflow: hidden;
    }

    .about-portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      display: block;
      filter: saturate(72%) contrast(110%) brightness(92%) sepia(10%) hue-rotate(5deg);
      transition: filter 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .about-portrait-frame::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 75%, rgba(6, 9, 7, 0.8) 100%);
      pointer-events: none;
    }

    .about-portrait-frame:hover .about-portrait-img {
      filter: saturate(82%) contrast(106%) brightness(97%) sepia(5%);
      transform: scale(1.02);
    }

    .about-content-col {
      padding-top: 1rem;
      max-width: 820px;
    }

    .about-tag {
      display: inline-block;
      font-size: 0.6875rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: var(--color-accent-ice);
      margin-bottom: 2.5rem;
      opacity: 0.9;
    }

    .about-statement {
      font-family: var(--font-serif);
      font-size: clamp(1.45rem, 2.3vw, 2.1rem);
      font-weight: 300;
      line-height: 1.5;
      color: var(--color-text-primary);
      letter-spacing: -0.01em;
      margin-bottom: 2.5rem;
      text-wrap: pretty;
    }

    .about-statement-secondary {
      color: rgba(242, 239, 235, 0.75);
      margin-bottom: 0;
    }

    /* --- Section: Engagements --- */
    .section-engagements {
      max-width: var(--container-max);
      margin: 0 auto;
      padding-block: clamp(6rem, 12vh, 10rem);
      padding-inline: clamp(1.5rem, 4vw, 4rem);
    }

    .engagements-header {
      margin-bottom: clamp(2.5rem, 5vh, 4rem);
    }

    .engagements-tag {
      font-size: 0.6875rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: var(--color-accent-ice);
      opacity: 0.9;
    }

    .engagements-list {
      display: flex;
      flex-direction: column;
    }

    .engagement-row {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: clamp(2rem, 5vw, 6rem);
      align-items: start;
      padding-block: clamp(2.5rem, 4.5vh, 3.5rem);
      border-top: 1px solid var(--color-border);
      transition: background-color var(--transition-smooth);
    }

    .engagement-row:last-child {
      border-bottom: 1px solid var(--color-border);
    }

    .engagement-main {
      max-width: 680px;
    }

    .engagement-title {
      font-family: var(--font-serif);
      font-size: clamp(1.4rem, 2vw, 1.85rem);
      font-weight: 300;
      line-height: 1.3;
      color: var(--color-text-primary);
      margin-bottom: 0.85rem;
    }

    .engagement-title em {
      font-style: italic;
    }

    .engagement-desc {
      font-size: 0.875rem;
      font-weight: 300;
      line-height: 1.7;
      color: var(--color-text-muted);
    }

    .engagement-meta {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-top: 0.35rem;
    }

    .engagement-meta .meta-label {
      font-size: 0.625rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--color-accent-ice);
      opacity: 0.85;
    }

    .engagement-meta .meta-value {
      font-size: 0.8125rem;
      font-weight: 300;
      color: var(--color-text-muted);
      line-height: 1.6;
    }

    /* --- Section: Repertoire (Editorial Program Format) --- */
    .section-repertoire {
      max-width: var(--container-max);
      margin: 0 auto;
      padding-block: clamp(6rem, 12vh, 10rem);
      padding-inline: clamp(1.5rem, 4vw, 4rem);
    }

    .repertoire-header {
      display: grid;
      grid-template-columns: minmax(280px, 380px) 1fr;
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
      margin-bottom: clamp(3.5rem, 7vh, 5.5rem);
    }

    .repertoire-tag {
      font-size: 0.6875rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: var(--color-accent-ice);
      opacity: 0.9;
    }

    .repertoire-intro {
      font-family: var(--font-serif);
      font-size: clamp(1.2rem, 1.8vw, 1.55rem);
      font-weight: 300;
      color: var(--color-text-primary);
      line-height: 1.5;
      max-width: 820px;
      text-wrap: pretty;
    }

    .repertoire-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 3.5vw, 4rem);
      align-items: stretch;
    }

    .repertoire-card {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 2rem;
    }

    .repertoire-title {
      font-family: var(--font-serif);
      font-size: clamp(1.4rem, 1.9vw, 1.75rem);
      font-weight: 300;
      color: var(--color-text-primary);
      line-height: 1.25;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border);
    }

    .repertoire-title em {
      font-style: italic;
    }

    .track-list {
      list-style: none;
      display: flex;
      flex-direction: column;
    }

    .track-item {
      display: grid;
      grid-template-columns: 18px 1fr auto;
      align-items: baseline;
      gap: 1.25rem;
      padding-block: 1.1rem;
      border-bottom: 1px solid var(--color-border);
      cursor: pointer;
      transition: border-color var(--transition-smooth);
    }

    .track-item:hover {
      border-bottom-color: rgba(230, 228, 221, 0.2);
    }

    .track-item.is-playing {
      border-bottom-color: var(--color-accent-ice);
    }

    /* Play-Pause Trigger */
    .track-index-btn {
      background: transparent;
      border: none;
      padding: 0;
      cursor: pointer;
      color: var(--color-text-primary);
      display: flex;
      align-items: center;
      justify-content: flex-start;
      opacity: 0.4;
      transition: opacity var(--transition-smooth), color var(--transition-smooth);
      height: 100%;
    }

    .track-index-btn svg {
      width: 10px;
      height: 10px;
      fill: currentColor;
    }

    .track-index-btn .icon-play {
      display: block;
    }

    .track-index-btn .icon-pause {
      display: none;
    }

    .track-item:hover .track-index-btn {
      opacity: 1;
      color: var(--color-accent-ice);
    }

    .track-item.is-playing .track-index-btn {
      opacity: 1;
      color: var(--color-accent-ice);
    }

    .track-item.is-playing .track-index-btn .icon-play {
      display: none;
    }

    .track-item.is-playing .track-index-btn .icon-pause {
      display: block;
    }

    /* Track Content */
    .track-info {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
    }

    .track-title {
      font-size: 0.8125rem;
      font-weight: 400;
      letter-spacing: 0.01em;
      color: var(--color-text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color var(--transition-smooth);
    }

    .track-sub {
      font-size: 0.6875rem;
      font-weight: 300;
      letter-spacing: 0.02em;
      color: var(--color-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color var(--transition-smooth);
    }

    .track-duration {
      font-size: 0.6875rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      font-variant-numeric: tabular-nums;
      opacity: 0.6;
      transition: color var(--transition-smooth), opacity var(--transition-smooth);
    }

    .track-item:hover .track-title,
    .track-item.is-playing .track-title {
      color: var(--color-accent-ice);
    }

    .track-item.is-playing .track-duration {
      color: var(--color-accent-ice);
      opacity: 1;
    }

    /* --- Section: Contact & Footer --- */
    .section-contact {
      max-width: var(--container-max);
      margin: 0 auto;
      padding-block: clamp(8rem, 15vh, 12rem);
      padding-inline: clamp(1.5rem, 4vw, 4rem);
      border-top: 1px solid var(--color-border);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: minmax(280px, 380px) 1fr;
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }

    .contact-tag {
      font-size: 0.6875rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: var(--color-accent-ice);
      opacity: 0.9;
    }

    .contact-content {
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 5vh, 4rem);
      max-width: 820px;
    }

    .contact-lead {
      font-family: var(--font-serif);
      font-size: clamp(1.2rem, 1.8vw, 1.55rem);
      font-weight: 300;
      color: var(--color-text-primary);
      line-height: 1.5;
      text-wrap: pretty;
    }

    .contact-direct-link {
      display: inline-block;
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 3.2vw, 2.75rem);
      font-weight: 300;
      color: var(--color-text-primary);
      text-decoration: none;
      letter-spacing: -0.01em;
      line-height: 1.15;
      width: fit-content;
      position: relative;
      padding-bottom: 0.25rem;
      border-bottom: 1px solid rgba(194, 214, 206, 0.35);
      transition: color var(--transition-smooth), border-color var(--transition-smooth);
    }

    .contact-direct-link:hover {
      color: var(--color-accent-ice);
      border-color: var(--color-accent-ice);
    }

    .contact-details-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .contact-detail-item {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .contact-detail-label {
      font-size: 0.625rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--color-text-muted);
    }

    .contact-detail-value {
      font-size: 0.8125rem;
      font-weight: 400;
      color: var(--color-text-primary);
      letter-spacing: 0.02em;
      line-height: 1.5;
    }

    .contact-detail-value a {
      color: var(--color-text-primary);
      text-decoration: none;
