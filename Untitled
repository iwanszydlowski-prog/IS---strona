  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const yearEl = document.getElementById('currentYear');
      if (yearEl) yearEl.textContent = new Date().getFullYear();

      // --- Header Scroll Observer ---
      const header = document.getElementById('siteHeader');
      const heroTrigger = document.getElementById('heroTrigger');

      if (header && heroTrigger) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            header.classList.toggle('scrolled', !entry.isIntersecting);
          });
        }, {
          rootMargin: '-72px 0px 0px 0px',
          threshold: 0
        });

        observer.observe(heroTrigger);
      }

      // --- Global Media Coordinator & Audio Engine ---
      let currentAudio = null;
      let currentItem = null;
      let fadeInterval = null;
      let activeIframe = null;

      const cleanupAudio = () => {
        if (fadeInterval) {
          clearInterval(fadeInterval);
          fadeInterval = null;
        }
        if (currentAudio) {
          currentAudio.pause();
          currentAudio.ontimeupdate = null;
          currentAudio.onended = null;
          currentAudio.removeAttribute('src');
          currentAudio.load();
          currentAudio = null;
        }
      };

      const stopActiveAudio = () => {
        cleanupAudio();
        if (currentItem) {
          currentItem.classList.remove('is-playing');
          const btn = currentItem.querySelector('.track-index-btn');
          const title = currentItem.querySelector('.track-title')?.textContent || '';
          const sub = currentItem.querySelector('.track-sub')?.textContent || '';
          if (btn) {
            btn.setAttribute('aria-pressed', 'false');
            btn.setAttribute('aria-label', `Odtwórz: ${title} — ${sub}`);
          }
          currentItem = null;
        }
      };

      const stopActiveVideo = () => {
        if (activeIframe && activeIframe.contentWindow) {
          activeIframe.contentWindow.postMessage(
            JSON.stringify({ event: 'command', func: 'pauseVideo', args: '' }),
            '*'
          );
        }
      };

      // --- Video Facade Loader ---
      const videoWrapper = document.getElementById('videoWrapper');
      const videoFacadeBtn = document.getElementById('videoFacadeBtn');

      if (videoWrapper && videoFacadeBtn) {
        videoFacadeBtn.addEventListener('click', () => {
          stopActiveAudio();

          const iframe = document.createElement('iframe');
          iframe.src = 'https://www.youtube-nocookie.com/embed/oUgY7CptWJo?autoplay=1&enablejsapi=1&rel=0&modestbranding=1&controls=1&showinfo=0&iv_load_policy=3';
          iframe.title = 'Erik Satie: Gymnopédie No.1 — Iwan Szydłowski';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;

          videoFacadeBtn.classList.add('is-hidden');
          activeIframe = iframe;

          setTimeout(() => {
            videoWrapper.appendChild(iframe);
            videoFacadeBtn.remove();
          }, 300);
        }, { once: true });
      }

      // --- Multi-track Audio Engine ---
      const trackItems = document.querySelectorAll('.track-item');

      trackItems.forEach(item => {
        const btn = item.querySelector('.track-index-btn');
        const sampleUrl = item.getAttribute('data-src');
        const title = item.querySelector('.track-title')?.textContent || '';
        const sub = item.querySelector('.track-sub')?.textContent || '';

        if (!btn || !sampleUrl) return;

        const togglePlay = () => {
          if (currentItem === item && currentAudio && !currentAudio.paused) {
            stopActiveAudio();
            return;
          }

          stopActiveVideo();
          stopActiveAudio();

          const audio = new Audio(sampleUrl);
          currentAudio = audio;
          currentItem = item;
          item.classList.add('is-playing');
          btn.setAttribute('aria-pressed', 'true');
          btn.setAttribute('aria-label', `Zatrzymaj: ${title} — ${sub}`);

          audio.volume = 0;
          const playPromise = audio.play();

          if (playPromise !== undefined) {
            playPromise.then(() => {
              let vol = 0;
              fadeInterval = setInterval(() => {
                if (vol < 0.9) {
                  vol += 0.1;
                  if (audio) audio.volume = vol;
                } else {
                  if (audio) audio.volume = 1;
                  clearInterval(fadeInterval);
                  fadeInterval = null;
                }
              }, 40);
            }).catch(() => {
              stopActiveAudio();
            });
          }

          audio.ontimeupdate = () => {
            if (audio.duration && audio.duration - audio.currentTime <= 2.5 && audio.volume > 0.1) {
              audio.volume = Math.max(0, audio.volume - 0.08);
            }
          };

          audio.onended = () => {
            stopActiveAudio();
          };
        };

        item.addEventListener('click', togglePlay);
      });
    });
  </script>
